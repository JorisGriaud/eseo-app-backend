# JWT Secret Key - REQUIS, l'application refuse de démarrer sans elle.
# Générer une valeur unique avec: openssl rand -hex 32
# Ne jamais réutiliser une valeur d'exemple trouvée dans un dépôt.
JWT_SECRET_KEY=

# Domain configuration pour SWAG
DOMAIN=votredomaine.com
EMAIL=votre@email.com

# Database (SQLite par défaut)
DATABASE_URL=sqlite:///./data/edt.db

# Firebase Cloud Messaging (pour notifications push)
# Chemin vers le fichier de credentials Firebase Admin SDK
# Obtenir depuis: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=./credentials/firebase-credentials.json
